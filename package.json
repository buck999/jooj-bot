{
  "name": "jooj-bot",
  "version": "1.0.0",
  "description": "Discord bot with music player, TTS, and AI features",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/discord-player-googlevideo/dist/YoutubeSabrExtractor.js';let c=fs.readFileSync(f,'utf8');c=c.replace(/\\[a-zA-Z0-9_-\\]\\{34\\}/,'[a-zA-Z0-9_-]+');fs.writeFileSync(f,c);\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buck999/jooj-bot.git"
  },
  "keywords": ["discord", "bot", "music", "tts"],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/buck999/jooj-bot/issues"
  },
  "homepage": "https://github.com/buck999/jooj-bot#readme",
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/opus": "^0.10.0",
    "@snazzah/davey": "^0.1.12",
    "discord-player": "^7.2.0",
    "discord-player-googlevideo": "^0.2.7",
    "discord-voip": "^7.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "ffmpeg-static": "^5.3.0",
    "sodium-native": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true,
    "esbuild@0.28.2": true
  }
}
