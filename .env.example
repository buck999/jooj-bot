# Discord Bot Token (obrigatório)
DISCORD_TOKEN=your_discord_bot_token_here

# Prefixo dos comandos (padrão: !)
PREFIX=!

# Módulos desligados, separados por vírgula (ex.: tts,music). Vazio = todos ligados.
DISABLED_MODULES=

# Lavalink (servidor de áudio). Rode com: docker compose up -d lavalink
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=troque_esta_senha

# YouTube OAuth no Lavalink (opcional, use conta DESCARTÁVEL). Veja lavalink/application.yml.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=

# Servidor de mídia interno (o Lavalink baixa o áudio do TTS daqui)
MEDIA_PORT=3001
# Endereço do bot visto PELO LAVALINK:
#   bot no host + Lavalink no Docker -> http://host.docker.internal:3001
#   ambos no docker compose          -> http://bot:3001 (já definido no compose)
MEDIA_PUBLIC_URL=http://host.docker.internal:3001

# ElevenLabs TTS (necessário para o comando !tts)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Debug mode (opcional)
# DEBUG=true
